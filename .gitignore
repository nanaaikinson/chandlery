# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# go build's default extensionless output for a package main directory
# (e.g. `go build ./...` run from inside examples/fiber leaves a `fiber`
# binary right next to fiber.go) — every examples/*/<dirname> program falls
# here.
/examples/*/fiber
/examples/*/nethttp

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/
.zed/

tmp/

# Added by code-review-graph
.code-review-graph/
