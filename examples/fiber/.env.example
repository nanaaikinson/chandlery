# Copy to .env and adjust. Real environment variables always win over
# whatever's in here (env.Load never overrides an already-set variable).

APP_ENV=local
PORT=8080

# db/postgres.DSN() falls back to this same value if DB_URL is unset or blank.
DB_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable

# "memory" (default, in-process, no setup) or "redis".
CACHE_DRIVER=memory
# Only read when CACHE_DRIVER=redis; cache/redis.Addr() falls back to this
# same value if unset or blank.
REDIS_URL=redis://127.0.0.1:6379/0
# How long a cached task read stays fresh before the next GET falls through
# to Postgres again.
CACHE_TTL_SECONDS=60
