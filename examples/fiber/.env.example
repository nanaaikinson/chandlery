# Copy to .env and adjust. Real environment variables always win over
# whatever's in here (env.Load never overrides an already-set variable).

APP_ENV=local
PORT=8080

# db/postgres.DSN() falls back to this same value if DB_URL is unset or blank.
DB_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable

# "memory" (default, in-process, no setup) or "redis".
CACHE_DRIVER=memory
# Only read when CACHE_DRIVER=redis; cache/redis.Addr() falls back to this
# same value if unset or blank.
REDIS_URL=redis://127.0.0.1:6379/0
# How long a cached task read stays fresh before the next GET falls through
# to Postgres again. <= 0 disables caching entirely for getTask (see
# handlers.go's cachingEnabled), rather than reaching cache.Store's own
# "ttl <= 0 means no expiry."
CACHE_TTL_SECONDS=60

# This app's own externally-reachable base URL. Only used to build a
# storage/local signed URL that resolves back to this app's /storage route
# (see main.go's serveSignedLocalFile) — s3's signed URLs point at the S3
# endpoint directly and ignore this.
APP_URL=http://localhost:8080

# "local" (default, this app's own filesystem) or "s3".
STORAGE_DRIVER=local
# Only read when STORAGE_DRIVER=local; where task attachments are written.
STORAGE_LOCAL_ROOT=./storage-example-fiber

# Only read when STORAGE_DRIVER=s3.
S3_BUCKET=chandlery-example
# storage/s3.Endpoint()/AccessKeyID()/SecretAccessKey() fall back to these
# same values if unset or blank — MinIO's own out-of-the-box dev
# credentials, so a local MinIO container needs zero further configuration.
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false
